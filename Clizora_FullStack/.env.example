# Application
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-long-random-secret
DB_FILE=./data/clizora.sqlite
SEED_DEMO=true
# Production only: set a private admin bootstrap account before the first startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Email OTP. Leave SMTP_HOST blank to use development mode (code printed in server terminal).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Clizora <no-reply@example.com>

# Mock payments are enabled only outside production. No real money is processed.
ALLOW_DEMO_PAYMENTS=true
